# Auction contract bytecode (auto-generated by pnpm compile-contract)
# Run: pnpm compile-contract
VITE_AUCTION_BYTECODE=

# Pinata IPFS JWT
VITE_PINATA_JWT=

# Pinata API base URL (optional, defaults to https://api.pinata.cloud)
VITE_PINATA_API_URL=

# Public IPFS gateway base used for opening/download links (e.g. https://gateway.pinata.cloud)
VITE_IPFS_GATEWAY_BASE=