# Blender 3.6.2
# www.blender.org

mtllib scene6.mtl

o Plane
g Plane
usemtl slab_tiles
v -1.000000 1.000000 0.000000
v -1.000000 -1.000000 0.000000
v 1.000000 1.000000 0.000000
v 1.000000 -1.000000 0.000000
vn 0.0000 00.0000 1.0000
vt 1.000000 0.000000
vt 0.000000 1.000000
vt 0.000000 0.000000
vt 1.000000 1.000000
s 0
f 2/1/1 3/2/1 1/3/1
f 2/1/1 4/4/1 3/2/1

o Light
g Light
usemtl white_light
v 1.0 0.25 0.05
v 1.0 -0.25 0.05
v 1.0 0.25 0.55
v 1.0 -0.25 0.55
vn -1.0000 0.0000 0.0000
vt 1.000000 0.000000
vt 0.000000 1.000000
vt 0.000000 0.000000
vt 1.000000 1.000000
s 0
f 6/5/2 7/6/2 5/7/2
f 6/5/2 8/8/2 7/6/2
